__pycache__/
*.pyc
.venv/
# built from source by setup_solvers.sh, not tracked
bin/
build/
tools/
# the DRAT proofs live on Zenodo: the largest is 2.6 GB and GitHub rejects
# anything over 100 MB.  certs/*.cnf.xz and certs/PROOFS.sha256 are tracked.
certs/*.drat
certs/*.drat.xz
certs_nosym/*.drat
certs_nosym/*.drat.xz
# build_tex/labels.json is tracked: the figures quote the manuscript's table
# numbers and read them from it.  Nothing else from a LaTeX build belongs here.
build_tex/*
!build_tex/labels.json
dist/
revision/work/
logs/
